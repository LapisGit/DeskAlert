<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <QtQmlModuleName>DeskAlert</QtQmlModuleName>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <OutputType>WinExe</OutputType>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <QtDir>E:\Qt-new\6.11.1\msvc2022_64\</QtDir>
    <QtBridgePackage>QtGroup.Qt.Bridge.CSharp.win-x64</QtBridgePackage>
  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <QtDir>/home/lapis/Qt/6.11.1/gcc_64/</QtDir>
    <QtBridgePackage>QtGroup.Qt.Bridge.CSharp.linux-x64</QtBridgePackage>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="$(QtBridgePackage)" Version="0.3.*-*" />
  </ItemGroup>

  <ItemGroup>
    <QtResource Include="defaultconfig.json" />
  </ItemGroup>

  <UsingTask
          TaskName="QtPatchMainCpp"
          TaskFactory="RoslynCodeTaskFactory"
          AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">

    <ParameterGroup>
      <MainCppPath ParameterType="System.String" Required="true" />
    </ParameterGroup>

    <Task>
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        if (File.Exists(MainCppPath))
        {
            var content = File.ReadAllText(MainCppPath);

            const string anchor = "    QGuiApplication app(argc, argv);";

            if (content.Contains(anchor) &&
                !content.Contains("setQuitOnLastWindowClosed"))
            {
                var nl = content.Contains("\r\n") ? "\r\n" : "\n";

                content = content.Replace(
                    anchor,
                    anchor + nl +
                    "    app.setQuitOnLastWindowClosed(false);");

                File.WriteAllText(MainCppPath, content);
            }
        }
      ]]></Code>
    </Task>

  </UsingTask>

  <Target
          Name="QtDisableQuitOnLastWindowClosed"
          AfterTargets="QtBridgeGenerate"
          BeforeTargets="QtBridgeBuild"
          Condition="'$(DesignTimeBuild)' != 'true'">

    <QtPatchMainCpp
            MainCppPath="$(MSBuildProjectDirectory)/$(IntermediateOutputPath)qt/native/source/cpp/main.cpp" />

  </Target>

  <Target
          Name="DeskAlertDeployIcon"
          AfterTargets="QtBridgeDeploy"
          Condition="'$(DesignTimeBuild)' != 'true'">

    <Copy
            SourceFiles="$(ProjectDir)icon.png"
            DestinationFolder="$(TargetDir)Application" />

  </Target>

</Project>